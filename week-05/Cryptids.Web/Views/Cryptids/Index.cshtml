@model List<Cryptid>

<h1>Cryptid Registry 👻</h1>
<p class="text-muted">@Model.Count creatures on file.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Region</th>
            <th>First sighting</th>
            <th>Reports</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cryptid in Model)
        {
            <tr>
                <td>@cryptid.Name</td>
                <td>@cryptid.Region</td>
                <td>@cryptid.FirstSighting</td>
                <td>@cryptid.Sightings</td>
                <td><a href="/Cryptids/Details/@cryptid.Id">Details</a></td>
            </tr>
        }
    </tbody>
</table>
